{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "outDir": "./dist",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@ema-agent/session": ["./packages/session/src/index.ts"],
      "@ema-agent/llm": ["./src/llm/index.ts"],
      "@ema-agent/context": ["./src/context/index.ts"],
      "@ema-agent/usage": ["./src/usage/index.ts"],
      "@ema-agent/tools": ["./packages/tools/src/index.ts"],
      "@ema-agent/permission": ["./packages/permission/src/index.ts"],
      "@ema-agent/sandbox": ["./packages/sandbox/src/index.ts"],
      "@ema-agent/attachment": ["./packages/attachment/src/index.ts"],
      "@ema-agent/memory": ["./packages/memory/src/index.ts"],
      "@ema-agent/prompts": ["./packages/prompts/src/index.ts"],
      "@ema-agent/skill": ["./packages/skill/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", ".turbo"]
}
