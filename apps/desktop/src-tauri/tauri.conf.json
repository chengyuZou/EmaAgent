{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ema",
  "version":     "0.1.0-beta.1",
  "identifier":  "com.emaagent.desktop",
  "build": {
    "beforeDevCommand": "node node_modules/vite/bin/vite.js",
    "beforeBuildCommand": "pnpm --filter @ema-agent/desktop build",
    "devUrl":             "http://127.0.0.1:1420",
    "frontendDist":       "../dist"
  },
  "app": {
    "windows": [
      {
        "label":         "stage",
        "title":         "Ema",
        "url":           "/",
        "width":         400,
        "height":        720,
        "transparent":   true,
        "decorations":   false,
        "alwaysOnTop":   true,
        "resizable":     false,
        "shadow":        false,
        "skipTaskbar":   false,
        "visible":       true,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "dangerousDisableAssetCspModification": ["style-src"],
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost blob: http: https: ws: wss:",
        "font-src": "'self' data:",
        "img-src": "'self' blob: data: http: https:",
        "media-src": "'self' blob: data: http: https:",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'"
      },
      "capabilities": ["main-window", "stage-window"]
    }
  },
  "bundle": {
    "active":     false,
    "targets":    "all",
    "icon":       ["../../../assets/icons/icon.png", "../../../assets/icons/icon.ico", "../../../assets/icons/icon.icns"],
    "category":   "Utility",
    "shortDescription": "Ema desktop pet + agent",
    "longDescription":  "Local-first desktop pet + agent — chat/work modes, character-driven."
  }
}
