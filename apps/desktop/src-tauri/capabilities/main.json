{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "桌宠主窗口可使用桌面窗口、文件选择与系统打开能力。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-is-visible",
    "dialog:default",
    "opener:default",
    "opener:allow-open-path"
  ]
}
