{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "allowImportingTsExtensions": false,
    "paths": {
      "@ema-agent/server": ["../server/src"],
      "@ema-agent/server/settings": ["../server/src/settings/definitions.ts"],
      "@ema-agent/server/*": ["../server/src/*"]
    }
  },
  "include": ["src", "vite.config.ts", "vitest.config.ts"]
}
