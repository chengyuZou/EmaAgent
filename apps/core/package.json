{
  "name": "@ema-agent/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@ema-agent/contracts": "workspace:*",
    "@ema-agent/storage": "workspace:*",
    "@ema-agent/hook": "workspace:*",
    "@ema-agent/llm": "workspace:*",
    "@ema-agent/prompts": "workspace:*",
    "@ema-agent/character-card": "workspace:*",
    "@ema-agent/session": "workspace:*",
    "@ema-agent/emotion": "workspace:*",
    "@ema-agent/conversation": "workspace:*",
    "@ema-agent/agent": "workspace:*",
    "@ema-agent/ebd-client": "workspace:*",
    "@ema-agent/narrative-client": "workspace:*",
    "@ema-agent/permission": "workspace:*",
    "@ema-agent/tool": "workspace:*",
    "@ema-agent/tool-builtin": "workspace:*",
    "@ema-agent/sandbox": "workspace:*",
    "@ema-agent/memory": "workspace:*",
    "@ema-agent/tts": "workspace:*",
    "@hono/node-server": "^1.14.3",
    "hono": "^4.7.10",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "rimraf": "^5.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^2.0.0"
  }
}