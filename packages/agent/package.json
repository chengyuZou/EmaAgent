{
  "name": "@ema-agent/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "DS_API_KEY=${DS_API_KEY} RUN_LIVE_LLM_TESTS=1 vitest run --include '**/*.integration.test.ts'",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@ema-agent/context": "workspace:*",
    "@ema-agent/contracts": "workspace:*",
    "@ema-agent/hook": "workspace:*",
    "@ema-agent/llm": "workspace:*",
    "@ema-agent/permission": "workspace:*",
    "@ema-agent/provider": "workspace:*",
    "@ema-agent/session": "workspace:*",
    "@ema-agent/emotion": "workspace:*",
    "@ema-agent/tools": "workspace:*",
    "@ema-agent/storage": "workspace:*",
    "@ema-agent/sandbox": "workspace:*",
    "@ema-agent/agent-context": "workspace:*",
    "@ema-agent/token": "workspace:*",
    "@ema-agent/tool-builtin": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.9.3",
    "vitest": "^2.0.0"
  }
}
