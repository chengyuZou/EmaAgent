{
  "name": "@ema-agent/live2d-react",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./store": {
      "import": "./dist/stores/live2d-store.js",
      "types": "./dist/stores/live2d-store.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build":     "tsc -p tsconfig.json",
    "dev":       "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test":      "vitest run",
    "clean":     "rimraf dist"
  },
  "peerDependencies": {
    "react":     "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "dependencies": {
    "pixi-live2d-display": "0.5.0-beta",
    "pixi.js":             "^7.4.3",
    "zustand":             "^5.0.2"
  },
  "devDependencies": {
    "@types/react":     "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "react":            "^18.3.1",
    "react-dom":        "^18.3.1",
    "rimraf":           "^5.0.0",
    "typescript":       "^5.9.3",
    "vitest":           "^2.0.0"
  }
}
