{
  "name": "@ema-agent/storage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.json && node --input-type=module -e \"import{cpSync}from'fs';cpSync('src/migrations','dist/migrations',{recursive:true})\"",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/migrate-cli.ts",
    "migrate:status": "tsx src/migrate-cli.ts --status",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@ema-agent/contracts": "workspace:*",
    "@node-rs/jieba": "^2.0.1",
    "better-sqlite3": "^12.9.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.0.0",
    "rimraf": "^5.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^2.0.0"
  }
}