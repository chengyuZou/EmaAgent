{
  "name": "ema-agent",
  "version": "0.1.0-beta.2",
  "private": true,
  "description": "EmaAgent — local-first anime companion + desktop agent",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@ema-agent/desktop",
    "dev:start": "pnpm --filter @ema-agent/desktop tauri:dev",
    "release": "pnpm --filter @ema-agent/desktop release",
    "dev:reset": "node scripts/dev-reset.mjs",
    "test:scripts": "pnpm --filter @ema-agent/desktop test:scripts",
    "test": "turbo run test --concurrency=2",
    "test:watch": "turbo watch test --concurrency=2",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.0.0",
    "saxes": "^6.0.0",
    "tsx": "^4.21.0",
    "turbo": "^2.0.0",
    "typescript": "^5.9.3",
    "vitest": "^2.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "pnpm": {
    "patchedDependencies": {
      "@laplace.live/pixijs-live2d@0.6.1": "patches/@laplace.live__pixijs-live2d@0.6.1.patch",
      "@pierre/trees@1.0.0-beta.6": "patches/@pierre__trees@1.0.0-beta.6.patch",
      "@mermaid-js/layout-elk@0.2.2": "patches/@mermaid-js__layout-elk@0.2.2.patch"
    }
  }
}
