{
  "name": "@ema-agent/backup",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.json",
    "dev": "rimraf dist && tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests --maxWorkers=1 --minWorkers=1",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@ema-agent/storage": "workspace:*",
    "archiver": "^8.0.0",
    "unzipper": "^0.12.5",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/node": "^20.0.0",
    "@types/unzipper": "^0.10.11",
    "rimraf": "^5.0.0",
    "typescript": "^5.9.3",
    "vitest": "^2.0.0"
  }
}
