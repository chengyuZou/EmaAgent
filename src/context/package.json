{
  "name": "@ema-agent/context",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./settings": { "types": "./dist/mediaSettings.d.ts", "import": "./dist/mediaSettings.js" },
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests --maxWorkers=1 --minWorkers=1",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@ema-agent/settings": "workspace:*",
    "sharp": "^0.33.5",
    "@ema-agent/attachments": "workspace:*",
    "@ema-agent/llm": "workspace:*",
    "@ema-agent/prompts": "workspace:*",
    "@ema-agent/session": "workspace:*",
    "@ema-agent/token": "workspace:*",
    "@ema-agent/tools": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.9.3",
    "vitest": "^2.0.0"
  }
}
