{
  "name": "@ema-agent/live2d-react",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build":     "tsc -p tsconfig.json",
    "dev":       "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test":      "vitest run --passWithNoTests",
    "clean":     "rimraf dist"
  },
  "peerDependencies": {
    "react":     "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "dependencies": {
    "@laplace.live/pixijs-live2d": "0.6.1",
    "@pixi/sound":          "6.0.1",
    "jszip":                "^3.10.1",
    "pixi.js":             "8.21.0"
  },
  "devDependencies": {
    "@types/react":     "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "react":            "^18.3.1",
    "react-dom":        "^18.3.1",
    "rimraf":           "^5.0.0",
    "typescript":       "^5.9.3",
    "vitest":           "^2.0.0"
  }
}
