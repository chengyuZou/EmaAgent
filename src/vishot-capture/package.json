{
  "name": "@ema-agent/vishot-capture",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./settings": {
      "types": "./dist/settings.d.ts",
      "import": "./dist/settings.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --maxWorkers=1 --minWorkers=1",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "sharp": "^0.33.5",
    "@ema-agent/settings": "workspace:*",
    "ffmpeg-static": "5.3.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.9.3",
    "vitest": "^2.0.0"
  }
}
